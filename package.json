{
  "name": "bpma-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "auth:bootstrap-dev": "node --experimental-strip-types prisma/bootstrap-dev-admin.ts",
    "buffet:reset-kplatz": "node --experimental-strip-types prisma/reset-buffet-amostras-kplatz.ts",
    "reset:kplatz-inicio": "node --no-warnings --experimental-strip-types prisma/reset-kplatz-inicio-operacao.ts",
    "reset:historicos-operacionais": "node --no-warnings --experimental-strip-types prisma/reset-historicos-operacionais.ts",
    "reset:historico-plano-diario": "node --no-warnings --experimental-strip-types prisma/reset-historico-plano-diario.ts",
    "limpar:notas:kplatz": "node --no-warnings --experimental-strip-types scripts/limpar-notas-importadas-kplatz.ts",
    "fotos:temperatura:dry-run": "node --no-warnings --experimental-strip-types scripts/migrar-fotos-temperatura-base64.ts migrar --dry-run",
    "fotos:temperatura:migrar": "node --no-warnings --experimental-strip-types scripts/migrar-fotos-temperatura-base64.ts migrar",
    "fotos:temperatura:reparar-arquivos-dry-run": "node --no-warnings --experimental-strip-types scripts/migrar-fotos-temperatura-base64.ts reparar --dry-run",
    "fotos:temperatura:reparar-arquivos": "node --no-warnings --experimental-strip-types scripts/migrar-fotos-temperatura-base64.ts reparar",
    "fotos:temperatura:diagnosticar": "node --no-warnings --experimental-strip-types scripts/migrar-fotos-temperatura-base64.ts diagnosticar",
    "fotos:temperatura:limpar-dry-run": "node --no-warnings --experimental-strip-types scripts/migrar-fotos-temperatura-base64.ts limpar --dry-run",
    "fotos:temperatura:limpar-base64": "node --no-warnings --experimental-strip-types scripts/migrar-fotos-temperatura-base64.ts limpar"
  },
  "prisma": {
    "seed": "node --experimental-strip-types prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.5.0",
    "dotenv": "^17.3.1",
    "next": "^15.2.8",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "20.17.30",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.5",
    "autoprefixer": "10.4.21",
    "eslint": "9.22.0",
    "eslint-config-next": "15.2.0",
    "postcss": "8.5.3",
    "prisma": "6.5.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.2"
  }
}
